# Model weights are fetched and checksum-verified, never committed
models/
*.onnx
*.pt
*.pth
*.safetensors

# Node
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Evaluation data and cached predictions (downloaded / regenerated, never committed)
eval/.data/
