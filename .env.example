# FaceLens API configuration. Copy to apps/api/.env for local development.
# All settings are validated at startup (`facelens-api check-config`).

FACELENS_ENVIRONMENT=development          # development | test | staging | production
FACELENS_LOG_LEVEL=INFO
FACELENS_LOG_JSON=true

# Persistence (use postgresql+psycopg://user:pass@host/db in staging/production)
FACELENS_DATABASE_URL=sqlite:///./var/facelens.db
FACELENS_AUTO_MIGRATE=true
FACELENS_STORAGE_BACKEND=local           # local | s3 (s3 required in production)
FACELENS_STORAGE_DIR=./var/blobs
# FACELENS_S3_BUCKET=facelens-prod
# FACELENS_S3_PREFIX=facelens
# FACELENS_S3_REGION=eu-west-1
# FACELENS_S3_ENDPOINT_URL=               # only for S3-compatible stores (SeaweedFS, MinIO, R2)
# FACELENS_S3_SSE=aws:kms                 # AES256 | aws:kms | none (none refused in production)
# FACELENS_S3_KMS_KEY_ID=

# Shared state for multi-replica deployments (Celery broker + rate limits)
# FACELENS_REDIS_URL=rediss://cache:6379/0

# Retention
FACELENS_SESSION_TTL_SECONDS=3600         # 60..86400; uploads + results deleted after this
FACELENS_METADATA_RETENTION_DAYS=30       # non-image job metadata
FACELENS_SWEEP_INTERVAL_SECONDS=300
FACELENS_SWEEPER_ENABLED=true

# Upload limits
FACELENS_MAX_UPLOAD_BYTES=10485760
FACELENS_MIN_IMAGE_SIDE=128
FACELENS_MAX_IMAGE_SIDE=4096

# Abuse controls (per client IP per minute)
FACELENS_RATE_LIMIT_UPLOADS_PER_MINUTE=10
FACELENS_RATE_LIMIT_JOBS_PER_MINUTE=30
FACELENS_RATE_LIMIT_BACKEND=memory        # memory | redis (redis required in production)

# Jobs
FACELENS_JOB_BACKEND=thread               # thread | sync | celery (celery required in production)
FACELENS_JOB_WORKERS=2
FACELENS_INFERENCE_TIMEOUT_SECONDS=30

# Face detection. Run `facelens-api fetch-models` once to download pinned weights.
FACELENS_FACE_DETECTOR=yunet              # yunet | none (none: UI work only, refused in production)
FACELENS_MODEL_DIR=./models
FACELENS_FACE_SCORE_THRESHOLD=0.7
FACELENS_MIN_FACE_SIDE=64

# Features and model policy
FACELENS_FEATURE_AGE_ESTIMATION=true
FACELENS_FEATURE_PRESENTATION_ESTIMATION=true
FACELENS_FEATURE_AGE_TRANSFORMATION=true
FACELENS_ALLOW_MOCK_MODELS=true           # refused when ENVIRONMENT=production
FACELENS_AGING_ALLOW_YOUNG_TARGETS=false  # requires safety + legal review

# Security. REQUIRED in staging/production: >=32 random chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FACELENS_SIGNING_SECRET=
FACELENS_RESULT_URL_TTL_SECONDS=300
FACELENS_CORS_ORIGINS=["http://localhost:3000"]
